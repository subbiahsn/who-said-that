{
  "rules": {
    ".read": false,
    ".write": false,

    "game": {
      ".read": "auth != null",
      ".write": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'"
    },
    "host": {
      ".read": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      ".write": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'"
    },
    "facts": {
      ".read": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      ".write": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'"
    },
    "players": {
      ".read": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      ".write": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        ".validate": "newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40"
      }
    },
    "guesses": {
      ".read": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      ".write": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      "$factId": {
        "$uid": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid && !data.exists() && newData.exists() && root.child('game/phase').val() === 'guessing' && root.child('game/factId').val() === $factId",
          ".validate": "newData.child('guess').isString() && newData.child('guess').val().length <= 60"
        }
      }
    },
    "likes": {
      ".read": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      ".write": "auth.uid === 'Y7G7OsI8smUGueybWz20EYVPOt23'",
      "$factId": {
        "$uid": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid && root.child('game/factId').val() === $factId",
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
